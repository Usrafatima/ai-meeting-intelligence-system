ENVIRONMENT=development
PORT=8000
SECRET_KEY=placeholder-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_intelligence
OPENAI_API_KEY=placeholder
GEMINI_API_KEY=placeholder

# Meeting file storage (module 3)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_SIZE_MB=1024

# Shared key the AI pipeline modules send as x-service-key
PIPELINE_SERVICE_KEY=replace-with-internal-service-key

# Speech-to-Text Configuration
GEMINI_API_KEY=your-gemini-api-key-here
STT_MODEL_PROVIDER=gemini  # "gemini" or "whisper"
WHISPER_MODEL_SIZE=base
HUGGINGFACE_TOKEN=your-huggingface-token-for-pyannote
