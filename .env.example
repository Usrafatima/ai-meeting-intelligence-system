# ==============================================================================
# AI Meeting Intelligence System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with actual credentials.
# Do NOT commit real secrets or credentials to version control.

# Application & Server
ENVIRONMENT=development
PORT=8000
SECRET_KEY=replace-with-a-secure-random-secret-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=""

# AI & LLM Providers (Speech-to-Text, Embeddings, Summarization, Q&A)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Object Storage (S3 / MinIO for audio/video & artifacts)
STORAGE_BUCKET=meeting-recordings
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=us-east-1

# Meeting File Storage (module 3: local disk or S3-compatible bucket)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=1024

# Service-to-Service Auth (pipeline modules -> meeting internal endpoints)
PIPELINE_SERVICE_KEY=replace-with-internal-service-key
